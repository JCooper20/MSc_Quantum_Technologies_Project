"""
GNN for the causal-DAG representation (Representation A of
graph_builder_causal.py).

Directed message passing: PyG convolutions pass messages from edge
source to edge target, and every edge in the DAG points forward in
time, so information flows strictly past -> future — directionality is
respected by construction. GINEConv is used so the 2-dim edge type
(causal vs line-membership) is consumed.

FROZEN from the previous experiments (pre-registration): hidden width
64, 3 message-passing layers, reference-pooling readout (here: mean
over the ref_readout terminal nodes, the DAG analogue of
reference-only pooling), the same MLP head, and the training recipe.
Only the representation (and the node/edge feature dimensions it
implies) is new.
"""

# Imports
from typing import Optional

import torch
import torch.nn.functional as F
from torch import Tensor
from torch_geometric.data import Data
from torch_geometric.nn import GINEConv, global_mean_pool

from src.gnn.graph_builder_causal import (CAUSAL_NODE_FEATURES,
                                          CAUSAL_EDGE_FEATURES)


class CausalDagPhaseGNN(torch.nn.Module):
    """Phase classifier over the operation-DAG representation."""

    def __init__(self, hidden_dim: int = 64, num_layers: int = 3):
        super().__init__()
        self.encoder = torch.nn.Linear(CAUSAL_NODE_FEATURES, hidden_dim)
        self.convs = torch.nn.ModuleList()
        for _ in range(num_layers):
            mlp = torch.nn.Sequential(
                torch.nn.Linear(hidden_dim, hidden_dim),
                torch.nn.ReLU(),
                torch.nn.Linear(hidden_dim, hidden_dim))
            self.convs.append(GINEConv(mlp, train_eps=True,
                                       edge_dim=CAUSAL_EDGE_FEATURES))
        self.head = torch.nn.Sequential(
            torch.nn.Linear(hidden_dim, hidden_dim // 2),
            torch.nn.ReLU(),
            torch.nn.Linear(hidden_dim // 2, 1),
        )

    def forward(self, data: Data,
                pool_mask: Optional[Tensor] = None) -> Tensor:
        x = F.relu(self.encoder(data.x))
        for conv in self.convs:
            x = F.relu(conv(x, data.edge_index, data.edge_attr))
        if pool_mask is None:
            pool_mask = data.x[:, 3] == 1        # ref_readout nodes
        if pool_mask.sum() == 0:
            raise ValueError("pool_mask selects no nodes")
        batch = getattr(data, "batch", None)
        if batch is None:
            batch = torch.zeros(x.size(0), dtype=torch.long)
        num_graphs = int(batch.max()) + 1
        pooled = global_mean_pool(x[pool_mask], batch[pool_mask],
                                  size=num_graphs)
        return self.head(pooled).squeeze(-1)
